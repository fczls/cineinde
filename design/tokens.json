{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Source de vérité des design tokens CineInde (format DTCG). Généré vers le :root d'index.html par design/build_tokens.py. Ne pas éditer le :root à la main.",
  "color": {
    "$description": "Nommage sémantique conservé de l'existant. Var CSS générée : --{clé} (ex. color.bg → --bg).",
    "bg": {
      "$type": "color",
      "$value": "#000000"
    },
    "bg2": {
      "$type": "color",
      "$value": "#191817"
    },
    "bg3": {
      "$type": "color",
      "$value": "#201f1d"
    },
    "bg4": {
      "$type": "color",
      "$value": "#272523"
    },
    "border": {
      "$type": "color",
      "$value": "rgba(255,255,255,.07)"
    },
    "border2": {
      "$type": "color",
      "$value": "rgba(255,255,255,.13)"
    },
    "gold": {
      "$type": "color",
      "$value": "#c9a84c"
    },
    "gold-dim": {
      "$type": "color",
      "$value": "#7a6430"
    },
    "text": {
      "$type": "color",
      "$value": "#f0ebe0"
    },
    "text-dim": {
      "$type": "color",
      "$value": "#7a7060"
    },
    "text-mid": {
      "$type": "color",
      "$value": "#a09080"
    },
    "accent": {
      "$type": "color",
      "$value": "#e8603a"
    },
    "green": {
      "$type": "color",
      "$value": "#4fa06a"
    },
    "compact-red": {
      "$type": "color",
      "$value": "#e00000"
    },
    "compact-times": {
      "$type": "color",
      "$value": "#9b9b9b"
    },
    "resa-line": {
      "$type": "color",
      "$value": "#595445"
    },
    "resa-tkt": {
      "$type": "color",
      "$value": "#CFBFAF"
    },
    "white": {
      "$type": "color",
      "$value": "#fff"
    },
    "neutral-lo": {
      "$type": "color",
      "$value": "#3a3a3a"
    },
    "neutral-mid": {
      "$type": "color",
      "$value": "#666"
    },
    "neutral-hi": {
      "$type": "color",
      "$value": "#848484"
    },
    "overlay-sm": {
      "$type": "color",
      "$value": "rgba(255,255,255,.04)"
    },
    "overlay-lg": {
      "$type": "color",
      "$value": "rgba(255,255,255,.28)"
    },
    "scrim-sm": {
      "$type": "color",
      "$value": "rgba(0,0,0,.25)"
    },
    "scrim-md": {
      "$type": "color",
      "$value": "rgba(0,0,0,.4)"
    },
    "scrim-lg": {
      "$type": "color",
      "$value": "rgba(0,0,0,.55)"
    },
    "scrim-xl": {
      "$type": "color",
      "$value": "rgba(0,0,0,.72)"
    },
    "scrim-2xl": {
      "$type": "color",
      "$value": "rgba(0,0,0,.85)"
    },
    "overlay-gold-sm": {
      "$type": "color",
      "$value": "rgba(201,168,76,.15)"
    },
    "overlay-gold-lg": {
      "$type": "color",
      "$value": "rgba(201,168,76,.5)"
    }
  },
  "fontSize": {
    "$description": "Échelle typo (7 pas). Var CSS générée : --fs-{clé}.",
    "xs": {
      "$type": "dimension",
      "$value": "10px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "md": {
      "$type": "dimension",
      "$value": "14px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "18px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "38px"
    }
  },
  "radius": {
    "$description": "Échelle de rayons (4 pas + pill). Var CSS générée : --radius-{clé}. pill=999px couvre pills ET cercles (sur un carré, 999px = cercle).",
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "16px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "breakpoint": {
    "$description": "Seuils responsive. NON générés en CSS (var() interdit dans @media) — présents ici pour la doc et Figma. md=820 = frontière mobile/desktop (max-width:820 / min-width:821).",
    "sm": {
      "$type": "dimension",
      "$value": "480px"
    },
    "md": {
      "$type": "dimension",
      "$value": "820px"
    }
  },
  "spacing": {
    "$description": "Grille de spacing 2px. NON générée en CSS (littéraux volontaires — value-tokeniser du spacing = alias de littéraux, faible ROI) : présente ici comme RÉFÉRENCE pour le lint P3 (padding/margin/gap doivent tomber sur la grille) et Figma. Pas frappés : positions précises (top: d'animation) et hairlines 1px.",
    "xs":  { "$type": "dimension", "$value": "4px" },
    "sm":  { "$type": "dimension", "$value": "8px" },
    "md":  { "$type": "dimension", "$value": "12px" },
    "lg":  { "$type": "dimension", "$value": "16px" },
    "xl":  { "$type": "dimension", "$value": "20px" },
    "2xl": { "$type": "dimension", "$value": "24px" },
    "3xl": { "$type": "dimension", "$value": "32px" },
    "4xl": { "$type": "dimension", "$value": "40px" }
  }
}